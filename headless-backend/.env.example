# ── Servidor ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── Base de datos (Neon PostgreSQL) ─────────────────────────────────────────
# postgresql://usuario:password@ep-xxx.us-east-2.aws.neon.tech/civicguard?sslmode=require
DATABASE_URL=

# ── CORS ────────────────────────────────────────────────────────────────────
# Lista blanca separada por comas. Ej:
# http://localhost:5173,https://civicguard.pages.dev,https://xxxx.ngrok-free.app
ALLOWED_ORIGINS=http://localhost:5173

# ── Administración ──────────────────────────────────────────────────────────
# Requerida por PATCH /api/incidents/:id/resolve (cabecera x-admin-key)
ADMIN_API_KEY=

# ── Sprint 4: notificaciones push (VAPID) ───────────────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:equipo@civicguard.mx

# ── Sprint 2: almacenamiento de fotos (Cloudinary) ──────────────────────────
CLOUDINARY_URL=
